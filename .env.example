# =========================
# LLM / RAG Configuration
# =========================

GROQ_API_KEY="your-groq-api-key"
TAVILY_API_KEY="your-tavily-api-key"

# Use a currently supported Groq model.
# Check Groq's official model list before choosing one.
CHAT_MODEL="your-groq-model"

# Ollama embedding model, e.g.:
# nomic-embed-text
OLLAMA_EMBED_MODEL="your-ollama-embedding-model"

# Flask server port
PORT=8000

# PostgreSQL database connection string
DATABASE_URL="your-database-uri"


# =========================
# Authentication
# =========================

# Generate a long random secret for production.
JWT_SECRET_KEY="generate-a-long-random-secret"

# Frontend URL
FRONTEND_URL="http://localhost:5173"

# false for local HTTP development.
# true when deploying with HTTPS.
COOKIE_SECURE=false

COOKIE_SAMESITE=Lax


# =========================
# Google OAuth
# =========================

# Google Cloud Console:
# Authorized JavaScript origin:
# http://localhost:5173
#
# Authorized redirect URI:
# http://localhost:8000/auth/google/callback

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"


# =========================
# Email OTP / SMTP
# =========================

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587

# Gmail address used to send OTP emails
SMTP_USERNAME="your-email@gmail.com"

# Gmail App Password, NOT your normal Gmail password
SMTP_PASSWORD="your-gmail-app-password"

SMTP_FROM="your-email@gmail.com"